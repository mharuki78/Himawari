{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/storefront.js": {
      "includeFiles": "product*.html"
    }
  },
  "rewrites": [
    { "source": "/products.html", "destination": "/api/storefront?page=catalog" },
    { "source": "/product.html", "destination": "/api/storefront?page=product" },
    { "source": "/api/auth/start", "destination": "/api/auth?route=start" },
    { "source": "/api/auth/callback/naver", "destination": "/api/auth?route=callback-naver" },
    { "source": "/api/auth/callback/google", "destination": "/api/auth?route=callback-google" },
    { "source": "/api/auth/session", "destination": "/api/auth?route=session" },
    { "source": "/api/auth/logout", "destination": "/api/auth?route=logout" },
    { "source": "/api/member/cart", "destination": "/api/member?route=cart" },
    { "source": "/api/member/wishlist", "destination": "/api/member?route=wishlist" },
    { "source": "/api/member/account", "destination": "/api/member?route=account" }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
