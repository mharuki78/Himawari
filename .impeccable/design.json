      "css": ".ds-secondary{font-family:var(--font-brand,\"Pretendard Local\",\"Pretendard Variable\",Pretendard,-apple-system,BlinkMacSystemFont,system-ui,sans-serif);min-height:44px;padding:12px 18px;border:0;border-radius:999px;background:var(--color-base-200,#f5f5f7);color:var(--ink,#202423);font-size:13px;cursor:pointer;box-shadow:none}.ds-secondary:hover{background:var(--color-base-200,#f5f5f7)}.ds-secondary:focus-visible{outline:2px solid var(--harbor,#315845);outline-offset:4px;}"
    },
    {
      "name": "Search utility control",
