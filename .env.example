# Vercel의 비공개 Blob 저장소를 프로젝트에 연결하면 자동으로 발급됩니다.
BLOB_READ_WRITE_TOKEN=

# 제품 카탈로그와 공개 제품 이미지용 Public Blob 저장소 토큰입니다.
PRODUCT_BLOB_READ_WRITE_TOKEN=

# `npm run secrets`가 출력하는 해시와 세션 서명 키를 사용하세요.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Vercel Marketplace에서 Neon을 연결하면 자동 등록됩니다.
DATABASE_URL=

# 32자 이상의 난수로 만들고 Vercel Secret으로만 등록하세요.
MEMBER_SESSION_SECRET=

# 간편 로그인 제공자 콘솔에서 발급합니다. 시크릿은 브라우저 코드에 넣지 않습니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 운영 OAuth 콜백과 로그인 복귀의 고정 기준 주소입니다.
PUBLIC_SITE_URL=https://allaboutbag.com
