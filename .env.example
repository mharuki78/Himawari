# Vercel의 비공개 Blob 저장소를 프로젝트에 연결하면 자동으로 발급됩니다.
BLOB_READ_WRITE_TOKEN=

# 제품 카탈로그와 공개 제품 이미지용 Public Blob 저장소 토큰입니다.
PRODUCT_BLOB_READ_WRITE_TOKEN=

# `npm run secrets`가 출력하는 해시와 세션 서명 키를 사용하세요.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Vercel Marketplace에서 Neon을 연결하면 자동 등록됩니다.
DATABASE_URL=

# 32자 이상의 난수로 만들고 Vercel Secret으로만 등록하세요.
MEMBER_SESSION_SECRET=

# 간편 로그인 제공자 콘솔에서 발급합니다. 시크릿은 브라우저 코드에 넣지 않습니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 운영 OAuth 콜백과 로그인 복귀의 고정 기준 주소입니다.
PUBLIC_SITE_URL=https://himawari.co.kr
# Optional: verified-domain sender for automatic restock emails (Resend)
RESEND_API_KEY=
RESTOCK_FROM_EMAIL=Himawari <restock@himawari.co.kr>

# 주문 접수·상태 변경 안내 메일. ORDER_FROM_EMAIL은 Resend에서 인증한 도메인을 사용합니다.
ORDER_FROM_EMAIL=Himawari <orders@himawari.co.kr>
ORDER_REPLY_TO=golf4484@naver.com

# 네이버페이 주문형 v2.1. 승인 전에는 false, 최종 오픈 승인 후에만 true로 바꿉니다.
NPAY_SHOP_ID=
NPAY_CERTI_KEY=
NPAY_BUTTON_KEY=
NPAY_ACCOUNT_ID=
NPAY_ENV=production
NPAY_PUBLIC_ENABLED=false
# 검수 URL 전용 32자 이상의 난수입니다. 실제 값은 Vercel Secret에만 저장합니다.
# /npay-review/{token}에서 실제 상품 상세페이지의 Sandbox 검수 세션을 시작합니다.
NPAY_REVIEW_TOKEN=

# 추가 인증 없이 선택적으로 담당자 비밀번호/권한을 설정합니다.
# [{"id":"shipping","role":"fulfillment","passwordHash":"scrypt$..."}]
ADMIN_STAFF_ACCOUNTS=[]
# 32바이트 난수의 base64. 백업과 별도의 비밀 저장소에 보관합니다.
BACKUP_ENCRYPTION_KEY=
# 복구 훈련용 별도 호스트의 빈 DB만 허용합니다.
RESTORE_DATABASE_URL=
